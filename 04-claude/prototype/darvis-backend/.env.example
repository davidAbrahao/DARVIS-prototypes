# Copie para .env e preencha. Nunca versione o .env.
ENVIRONMENT=development
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-caracteres
# Dev local (SQLite). Para o Supabase use a string de conexão do Postgres:
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres
DATABASE_URL=sqlite:///./darvis.db
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
CORS_ORIGINS=["http://localhost:3000"]
