# Copie para .env apenas no ambiente local. Nunca versione credenciais reais.
APP_ENV=development
APP_NAME=D.A.R.V.I.S. API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL local ou gerenciado. Deixe vazio somente enquanto o banco não estiver configurado.
# Exemplo: postgresql+psycopg://darvis:senha-local@localhost:5432/darvis
DATABASE_URL=

# Obrigatório em produção: segredo aleatório com pelo menos 32 bytes.
# Gere localmente com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
