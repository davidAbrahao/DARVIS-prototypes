# Copie para .env apenas no ambiente local. Nunca versione credenciais reais.
APP_ENV=development
APP_NAME=D.A.R.V.I.S. API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Banco local para o Docker Compose.
POSTGRES_USER=darvis
POSTGRES_DB=darvis
# Defina uma senha aleatória antes de iniciar o contêiner.
POSTGRES_PASSWORD=
# Use uma senha com caracteres URL-safe ou codifique caracteres reservados.
# Exemplo: postgresql+psycopg://darvis:SENHA@localhost:5432/darvis
DATABASE_URL=

# Segredo de assinatura e token de configuração inicial (mínimo de 32 bytes cada).
# Gere valores independentes com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
INITIAL_SETUP_TOKEN=

# Access token curto e refresh token renovável.
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=30

# Assistente de IA: permanece desativado até a configuração explícita da credencial.
AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
