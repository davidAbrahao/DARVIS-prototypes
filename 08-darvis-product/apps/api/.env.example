# Copie para .env apenas no ambiente local. Nunca versione credenciais reais.
APP_ENV=development
APP_NAME=D.A.R.V.I.S. API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Banco local para o Docker Compose.
POSTGRES_USER=darvis
POSTGRES_DB=darvis
# Defina uma senha aleatória antes de iniciar o contêiner.
POSTGRES_PASSWORD=
# Use uma senha com caracteres URL-safe ou codifique caracteres reservados.
# Exemplo: postgresql+psycopg://darvis:SENHA@localhost:5432/darvis
DATABASE_URL=

# Obrigatório em produção: segredo aleatório com pelo menos 32 bytes.
# Gere localmente com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
